# Qdrant Configuration
# Set this to override the default Qdrant server URL
# If not set, the app will use localhost:6333 for development or the current domain for production

# Example for a custom Qdrant server:
# VITE_QDRANT_BASE_URL=https://my-qdrant-server.com:6333

# Example for local development with custom port:
# VITE_QDRANT_BASE_URL=http://localhost:9333

# Example for remote Qdrant server:
# VITE_QDRANT_BASE_URL=http://192.168.1.100:6333

# Example for Qdrant Cloud:
# VITE_QDRANT_BASE_URL=https://your-cluster-url.aws.cloud.qdrant.io

# To use this file:
# 1. Copy this file to .env.local
# 2. Uncomment and modify the VITE_QDRANT_BASE_URL line with your server URL
# 3. Restart the development server
